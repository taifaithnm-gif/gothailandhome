# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# responsive matrix visual captures (P1-03 policy; keep README tracked)
/artifacts/responsive/**/*.png
/artifacts/responsive/**/*.webp
/artifacts/responsive/**/*.jpg
/artifacts/responsive/**/*.jpeg

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# vercel
.vercel

# property factory run ledgers (local apply/resume)
/content/_runs/
/content/_raw/

# Windows01 local import workspace artifacts (keep README + mock fixtures)
/staging/import/*.json
/staging/quarantine/*.json
/staging/archive/**
!/staging/archive/README.md
/logs/import/*.log.json
/logs/import/*.json
!/logs/import/README.md
/documents/review/*.json
!/documents/review/README.md

# typescript
*.tsbuildinfo
next-env.d.ts

# Local isolated import workspaces (never commit)
.work/

# Mock import evidence binaries (JSON/README may be tracked separately)
/documents/imports/mock/RESULTS/**/*.pdf
/documents/imports/mock/RESULTS/**/*.jpg
/documents/imports/mock/RESULTS/**/*.jpeg
/documents/imports/mock/RESULTS/**/*.png
/documents/imports/mock/RESULTS/**/*.html
