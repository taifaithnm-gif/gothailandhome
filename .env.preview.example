# Vercel Preview — MUST target Staging Supabase (never Production)
# Set these in Vercel → Project → Settings → Environment Variables → Preview
APP_DEPLOY_ENV=preview
VERCEL_ENV=preview

SUPABASE_PRODUCTION_PROJECT_REF=your-production-project-ref
SUPABASE_STAGING_PROJECT_REF=your-staging-project-ref

NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key

# Prefer Preview deployment URL or a dedicated staging hostname
NEXT_PUBLIC_SITE_URL=https://your-preview-or-staging-host.example

# Staging Postgres only (do NOT inherit Production POSTGRES_*)
# POSTGRES_URL=postgresql://...staging...
# POSTGRES_URL_NON_POOLING=postgresql://...staging...

# Flags: enable only during T1–T10 staging trains (still OFF by default)
FEATURE_P2_ACCOUNT=false
NEXT_PUBLIC_FEATURE_P2_ACCOUNT=false
FEATURE_P2_OPS_LEADS=false
FEATURE_P2_NOTIFICATIONS=false
FEATURE_P2_CRM_SYNC=false
FEATURE_P2_ACQUISITION=false
NEXT_PUBLIC_FEATURE_P2_ACQUISITION=false
FEATURE_P2_PARTNER_PORTAL=false
NEXT_PUBLIC_FEATURE_P2_PARTNER_PORTAL=false
FEATURE_P2_MAP=false
NEXT_PUBLIC_FEATURE_P2_MAP=false
FEATURE_P2_TOOLS=false
NEXT_PUBLIC_FEATURE_P2_TOOLS=false
FEATURE_P2_AI=false
NEXT_PUBLIC_FEATURE_P2_AI=false
FEATURE_P2_AI_KILL_SWITCH=false
FEATURE_P2_ANALYTICS_EXPANSION=false
