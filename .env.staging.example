# Staging-only environment template.
# Copy to .env.staging.local on this Mac mini. NEVER commit real values.
# NEVER copy these into .env.production or Production Vercel envs.

# Feature gates (default OFF)
STAGING_IMPORT_ENABLED=false
STAGING_COMMIT_ENABLED=false
STAGING_STORAGE_UPLOAD_ENABLED=false
STAGING_INTEGRATION_TEST_ENABLED=false
STAGING_REVIEWER_GATE_ENABLED=true

# Isolation markers (required before any real write)
STAGING_ENVIRONMENT_ID=
STAGING_PROJECT_REF=
# Direct DB host only (e.g. db.<project-ref>.supabase.co) — NOT API host, NOT pooler host
STAGING_ALLOWED_HOST=
# Session pooler host only (e.g. aws-0-<region>.pooler.supabase.com)
STAGING_ALLOWED_POOLER_HOST=

# Staging Supabase / Postgres (independent project — NOT Production)
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# Direct connection (IPv6 often). Kept as configuration record.
STAGING_DATABASE_URL=
# Preferred for Probe / Migration / RLS live on Mac mini (Session mode, port 5432)
# Username MUST be postgres.<STAGING_PROJECT_REF>
STAGING_DATABASE_POOLER_URL=
STAGING_STORAGE_BUCKET=goth-staging-assets

# Optional production markers used ONLY for isolation comparison (never as write targets)
# SUPABASE_PRODUCTION_PROJECT_REF=
# PRODUCTION_SUPABASE_URL=
# PRODUCTION_DATABASE_URL=

# Controlled commit digest pin (example Batch001 sealed digest)
# STAGING_EXPECTED_SEALED_DIGEST=d709a72c2ff89bbdb3c24a7a64d5766a76cb754e1bdaba6f7e49d34680ec6786
