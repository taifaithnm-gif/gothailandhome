# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_OR_LOCAL_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Environment isolation markers (no secrets)
# development | preview | production | test
APP_DEPLOY_ENV=development
# Production project ref — used to BLOCK non-prod from connecting to it
SUPABASE_PRODUCTION_PROJECT_REF=your-production-project-ref
# Staging project ref — required for development/preview once staging exists
SUPABASE_STAGING_PROJECT_REF=your-staging-project-ref

# Site / Auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (server/scripts only — staging credentials for local/preview)
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# DATABASE_URL=

# Internal admin bootstrap (used by setup scripts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Future ads (placeholders until campaigns go live)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Frontend analytics (GA4) — inert when empty; loads only after analytics consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Phase 2 feature flags — default OFF (Phase 1 behavior). Do not enable in production
# without Owner release approval. See docs/phase2/m0/P2-003_FEATURE_FLAG_POLICY.md
FEATURE_P2_ACCOUNT=false
NEXT_PUBLIC_FEATURE_P2_ACCOUNT=false
FEATURE_P2_OPS_LEADS=false
FEATURE_P2_NOTIFICATIONS=false
FEATURE_P2_CRM_SYNC=false
FEATURE_P2_ACQUISITION=false
NEXT_PUBLIC_FEATURE_P2_ACQUISITION=false
FEATURE_P2_PARTNER_PORTAL=false
NEXT_PUBLIC_FEATURE_P2_PARTNER_PORTAL=false
FEATURE_P2_MAP=false
NEXT_PUBLIC_FEATURE_P2_MAP=false
FEATURE_P2_TOOLS=false
NEXT_PUBLIC_FEATURE_P2_TOOLS=false
FEATURE_P2_AI=false
NEXT_PUBLIC_FEATURE_P2_AI=false
FEATURE_P2_AI_KILL_SWITCH=false
FEATURE_P2_ANALYTICS_EXPANSION=false

# Optional Phase 2 integrations (server-only; unused when related flags are false)
# RESEND_API_KEY=
# NOTIFICATIONS_FROM_EMAIL=
# CRM_WEBHOOK_URL=
# CRM_WEBHOOK_SECRET=
